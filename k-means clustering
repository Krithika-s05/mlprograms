import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import silhouette_score

df = pd.read_csv(r"C:\Users\Admin\Desktop\ml\train_data.csv")
df = df.drop_duplicates().fillna(df.median(numeric_only=True))
df = pd.get_dummies(df, drop_first=True)
X = StandardScaler().fit_transform(df)

best_k, best_s = 2, -1
for k in range(2, 6):
    c = np.random.uniform(X.min(0), X.max(0), (k, X.shape[1]))
    for _ in range(50):
        d = np.sqrt(((X[:, None] - c) ** 2).sum(2))
        y = np.argmin(d, 1)
        nc = np.array([X[y == i].mean(0) if np.any(y == i) else c[i]
                       for i in range(k)])
        if np.allclose(c, nc): break
        c = nc
    s = silhouette_score(X, y)
    if s > best_s: best_k, best_s = k, s

k = best_k
c = np.random.uniform(X.min(0), X.max(0), (k, X.shape[1]))

for _ in range(100):
    d = np.sqrt(((X[:, None] - c) ** 2).sum(2))
    y = np.argmin(d, 1)
    nc = np.array([X[y == i].mean(0) if np.any(y == i) else c[i]
                   for i in range(k)])
    if np.allclose(c, nc): break
    c = nc

for i in range(k):
    print("\nCluster", i + 1)
    print(df[y == i])

plt.scatter(X[:, 0], X[:, 1], c=y)
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.title("K-Means Clustering")
plt.show()
